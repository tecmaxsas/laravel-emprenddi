# =====================================================================
# .env.production — TEMPLATE
# Copia este archivo a .env.production EN LA VM y rellena los valores.
# NUNCA commitear .env.production con secretos reales.
# =====================================================================

APP_NAME=Emprenddi
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://pos.emprenddi.com
APP_TIMEZONE=America/Bogota

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_CO

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=emprenddi
DB_USERNAME=emprenddi
DB_PASSWORD=CAMBIAR_PASSWORD_FUERTE_AQUI

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis

REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PASSWORD=CAMBIAR_PASSWORD_REDIS_AQUI
REDIS_PORT=6379

# Email (configurar con SMTP real o Mailgun/SES)
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="no-reply@emprenddi.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Filament — superadmin (único usuario que opera el panel /super-admin)
FILAMENT_SUPERADMIN_EMAIL=desarrollotecmax@gmail.com
# Solo se usa la PRIMERA vez que corre el seeder, para crear el superadmin.
# Después del primer login, cambia el password por UI y borra esta línea.
FILAMENT_SUPERADMIN_INITIAL_PASSWORD=
FILAMENT_FILESYSTEM_DISK=public

# DIAN Facturación Electrónica
DIAN_ENV=produccion
DIAN_PROVIDER=
DIAN_API_KEY=
DIAN_API_URL=

# Google Cloud Storage (opcional para storage en GCS)
GOOGLE_CLOUD_PROJECT_ID=
GOOGLE_CLOUD_STORAGE_BUCKET=
GOOGLE_CLOUD_KEY_FILE=
